# Obsidian per-machine UI state: open panes, cursor positions, recent files.
# Rewritten constantly, so tracking it causes sync conflicts across devices.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Plugin code, not plugin output. Multi-megabyte bundles that would grow the
# repo on every update; install plugins per device instead. Drawings and notes
# created by plugins live elsewhere in the vault and are still tracked.
.obsidian/plugins/

# Source exports from OneNote. A single handwritten page renders to ~85 MB because
# the ink and photos are rasterised. These are conversion input, not knowledge:
# convert to markdown, keep the original in OneDrive. Force one in with `git add -f`.
*.pdf

# Obsidian's soft-delete folder
.trash/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
